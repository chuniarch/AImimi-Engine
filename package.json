{
  "name": "refactored-games202-project",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:dev": "LINT_MODE=development eslint .",
    "lint:prod": "LINT_MODE=production eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,css,html,md,glsl,vert,frag,vs,fs,glslf,glslv}\" \"tests/**/*.ts\" \"*.{js,ts,json,md,html}\" \".prettierrc.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,css,html,md,glsl,vert,frag,vs,fs,glslf,glslv}\" \"tests/**/*.ts\" \"*.{js,ts,json,md,html}\" \".prettierrc.json\"",
    "check": "npm run type-check && npm run lint:prod && npm run format:check",
    "fix": "npm run lint:fix && npm run format",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky install",
    "commit": "cz"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@tweakpane/core": "^2.0.5",
    "dat.gui": "^0.7.9",
    "gl-matrix": "^3.4.3",
    "three": "^0.177.0",
    "tweakpane": "^4.0.5",
    "url-join": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@html-eslint/eslint-plugin": "^0.52.1",
    "@types/dat.gui": "^0.7.13",
    "@types/node": "^24.0.3",
    "@types/three": "^0.177.0",
    "@vitest/browser": "4.1.5",
    "@vitest/browser-playwright": "^4.1.5",
    "commitizen": "^4.3.1",
    "cz-git": "^1.12.0",
    "eslint": "^9.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-markdown": "^5.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "mathjs": "^15.2.0",
    "playwright": "^1.59.1",
    "prettier": "^3.6.2",
    "prettier-plugin-glsl": "^0.2.2",
    "rollup-plugin-visualizer": "^6.0.3",
    "terser": "^5.43.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^6.3.5",
    "vitest": "4.1.5"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  }
}
